{
  "name": "@deepseek-ai/dsh-execution",
  "description": "Abstract execution service seam (ctx.execution) for the DeepSeek Harness",
  "version": "0.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/trading/execution"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./errors": {
      "types": "./lib/types/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./validation": {
      "types": "./lib/types/validation.d.ts",
      "default": "./lib/validation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/errors.js",
    "lib/validation.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
